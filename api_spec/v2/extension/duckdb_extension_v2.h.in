// WARNING: this API is not yet stable, meaning it is only guaranteed to work for this specific DuckDB version.

#pragma once

// An extension targets either the V1 or the V2 C API, never both.
#ifdef DUCKDB_EXTENSION_HEADER_VERSION
#error "duckdb_extension.h and duckdb_extension_v2.h cannot both be included: pick one C API version"
#endif
#define DUCKDB_EXTENSION_HEADER_VERSION 2

#include "duckdb_v2.h"

//===--------------------------------------------------------------------===//
// Util Macros
//===--------------------------------------------------------------------===//

#ifdef __cplusplus
#define DUCKDB_EXTENSION_EXTERN_C_GUARD_OPEN  extern "C" {
#define DUCKDB_EXTENSION_EXTERN_C_GUARD_CLOSE }
#else
#define DUCKDB_EXTENSION_EXTERN_C_GUARD_OPEN
#define DUCKDB_EXTENSION_EXTERN_C_GUARD_CLOSE
#endif

#define DUCKDB_EXTENSION_GLUE_HELPER(x, y) x##y
#define DUCKDB_EXTENSION_GLUE(x, y)        DUCKDB_EXTENSION_GLUE_HELPER(x, y)
#define DUCKDB_EXTENSION_STR_HELPER(x)     #x
#define DUCKDB_EXTENSION_STR(x)            DUCKDB_EXTENSION_STR_HELPER(x)
#define DUCKDB_EXTENSION_SEMVER_STRING(major, minor, patch)                                                            \
	"v" DUCKDB_EXTENSION_STR_HELPER(major) "." DUCKDB_EXTENSION_STR_HELPER(minor) "." DUCKDB_EXTENSION_STR_HELPER(patch)

//===--------------------------------------------------------------------===//
// Versioning
//===--------------------------------------------------------------------===//
//! Set version to latest if no explicit version is defined

#if !defined(DUCKDB_EXTENSION_API_VERSION_MAJOR) && !defined(DUCKDB_EXTENSION_API_VERSION_MINOR) &&                    \
    !defined(DUCKDB_EXTENSION_API_VERSION_PATCH)
#define DUCKDB_EXTENSION_API_VERSION_MAJOR 2
#define DUCKDB_EXTENSION_API_VERSION_MINOR 0
#define DUCKDB_EXTENSION_API_VERSION_PATCH 0
#elif !(defined(DUCKDB_EXTENSION_API_VERSION_MAJOR) && defined(DUCKDB_EXTENSION_API_VERSION_MINOR) &&                  \
        defined(DUCKDB_EXTENSION_API_VERSION_PATCH))
#error "either all or none of the  DUCKDB_EXTENSION_API_VERSION_ defines should be defined"
#endif

//! The version string passed to DuckDB on extension load. The major selects the V2 API family; for extensions pinned
//! to an exact DuckDB version (C_STRUCT_UNSTABLE) the loader reads only the major and ignores the rest.
#define DUCKDB_EXTENSION_API_VERSION_STRING                                                                            \
	DUCKDB_EXTENSION_SEMVER_STRING(DUCKDB_EXTENSION_API_VERSION_MAJOR, DUCKDB_EXTENSION_API_VERSION_MINOR,             \
	                               DUCKDB_EXTENSION_API_VERSION_PATCH)

#if DUCKDB_EXTENSION_API_VERSION_MAJOR != 2
#error "This version of the extension API header only supports API VERSION v2.x.x"
#endif

//===--------------------------------------------------------------------===//
// Extension access (loader interface)
//===--------------------------------------------------------------------===//

//! Opaque forward declarations of the loader's V1-named types (duckdb_v2_extension_handle itself is a typedef of the
//! loader's token type, declared by duckdb_v2.h). The entrypoint and the access callbacks are called through function
//! pointers typed against these on the loader side, so the signatures here must spell the same underlying types for
//! the function types to match exactly (checked under -fsanitize=function).
struct _duckdb_database;
struct duckdb_extension_access;

//! Passed to the C API extension entrypoint by the loader. Layout matches the V1 loader interface.
struct duckdb_v2_extension_access {
	//! Indicate that an error has occurred.
	void (*set_error)(duckdb_v2_extension_handle extension, const char *error);
	//! Fetch the V1 database handle. Unused by V2 extensions; present for loader ABI layout.
	struct _duckdb_database **(*get_database)(duckdb_v2_extension_handle extension);
	//! Fetch the API struct pointer for the requested version.
	const void *(*get_api)(duckdb_v2_extension_handle extension, const char *version);
};

//===--------------------------------------------------------------------===//
// Function pointer struct
//===--------------------------------------------------------------------===//
typedef struct {
#if DUCKDB_EXTENSION_API_VERSION_MINOR > 0 ||                                                                          \
    (DUCKDB_EXTENSION_API_VERSION_MINOR == 0 && DUCKDB_EXTENSION_API_VERSION_PATCH >= 0) // v2.0.0
	DUCKDB_V2_ERROR (*duckdb_v2_error_info_set_code)(duckdb_v2_error_info_handle info, DUCKDB_V2_ERROR code);
	DUCKDB_V2_ERROR (*duckdb_v2_error_info_set_text)(duckdb_v2_error_info_handle info, duckdb_v2_str text);
	DUCKDB_V2_ERROR (*duckdb_v2_error_info_destroy)(duckdb_v2_error_info_handle *info);
#endif
	// capigen:begin appended
	// capigen:end appended
} duckdb_ext_api_v2;

//===--------------------------------------------------------------------===//
// Typedefs mapping functions to struct entries
//===--------------------------------------------------------------------===//
// When building as a static extension, DuckDB symbols are resolved directly at link time.
// The vtable (duckdb_ext_api) is not used - skip these macro redirections.
#ifndef DUCKDB_BUILD_STATIC_EXTENSION
// Version v2.0.0
#define duckdb_v2_error_info_set_code duckdb_ext_api.duckdb_v2_error_info_set_code
#define duckdb_v2_error_info_set_text          duckdb_ext_api.duckdb_v2_error_info_set_text
#define duckdb_v2_error_info_destroy           duckdb_ext_api.duckdb_v2_error_info_destroy

// capigen:begin appended
// capigen:end appended
#endif // DUCKDB_BUILD_STATIC_EXTENSION

//===--------------------------------------------------------------------===//
// Struct Global Macros
//===--------------------------------------------------------------------===//
#ifdef DUCKDB_BUILD_STATIC_EXTENSION
// No vtable global needed for static builds - DuckDB symbols are resolved directly at link time
#define DUCKDB_EXTENSION_GLOBAL
#define DUCKDB_EXTENSION_API_INIT(info, access, minimum_api_version)
#else
// This goes in the c/c++ file containing the entrypoint
#define DUCKDB_EXTENSION_GLOBAL duckdb_ext_api_v2 duckdb_ext_api = {0};
// Initializes the C Extension API: First thing to call in the extension entrypoint
#define DUCKDB_EXTENSION_API_INIT(info, access, minimum_api_version)                                                   \
	duckdb_ext_api_v2 *res = (duckdb_ext_api_v2 *)access->get_api(info, minimum_api_version);                          \
	if (!res) {                                                                                                        \
		return false;                                                                                                  \
	};                                                                                                                 \
	duckdb_ext_api = *res;
#endif // DUCKDB_BUILD_STATIC_EXTENSION

// Place in global scope of any C/C++ file that needs to access the extension API
#define DUCKDB_EXTENSION_EXTERN extern duckdb_ext_api_v2 duckdb_ext_api;

#ifdef _WIN32
#define DUCKDB_CAPI_ENTRY_VISIBILITY __declspec(dllexport)
#else
#define DUCKDB_CAPI_ENTRY_VISIBILITY __attribute__((visibility("default")))
#endif

//===--------------------------------------------------------------------===//
// Entrypoint Macros
//===--------------------------------------------------------------------===//

// Note: the DUCKDB_EXTENSION_ENTRYPOINT macro requires DUCKDB_EXTENSION_NAME to be set.

#ifdef DUCKDB_EXTENSION_NAME

// Main entrypoint: receives the extension being loaded for the extension to register its functionality through. The
// extension handle doubles as the loader token taken by the access callbacks (set_error).
#define DUCKDB_EXTENSION_ENTRYPOINT                                                                                    \
	DUCKDB_EXTENSION_GLOBAL static bool DUCKDB_EXTENSION_GLUE(DUCKDB_EXTENSION_NAME, _init_c_api_internal)(            \
	    duckdb_v2_extension_handle extension, struct duckdb_v2_extension_access * access);                             \
	DUCKDB_EXTENSION_EXTERN_C_GUARD_OPEN DUCKDB_CAPI_ENTRY_VISIBILITY DUCKDB_EXTENSION_API bool DUCKDB_EXTENSION_GLUE( \
	    DUCKDB_EXTENSION_NAME,                                                                                         \
	    _init_c_api)(duckdb_v2_extension_handle extension, struct duckdb_extension_access * access_p) {                \
		struct duckdb_v2_extension_access *access = (struct duckdb_v2_extension_access *)(void *)access_p;             \
		DUCKDB_EXTENSION_API_INIT(extension, access, DUCKDB_EXTENSION_API_VERSION_STRING);                             \
		return DUCKDB_EXTENSION_GLUE(DUCKDB_EXTENSION_NAME, _init_c_api_internal)(extension, access);                  \
	}                                                                                                                  \
	DUCKDB_EXTENSION_EXTERN_C_GUARD_CLOSE static bool DUCKDB_EXTENSION_GLUE(DUCKDB_EXTENSION_NAME, _init_c_api_internal)

// Custom entrypoint: identical to the main entrypoint
#define DUCKDB_EXTENSION_ENTRYPOINT_CUSTOM DUCKDB_EXTENSION_ENTRYPOINT
#endif
