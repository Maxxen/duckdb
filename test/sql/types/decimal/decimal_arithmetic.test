# name: test/sql/types/decimal/decimal_arithmetic.test
# description: Test basic decimals
# group: [decimal]

# negate
query II
SELECT -('0.1'::DECIMAL), -('-0.1'::DECIMAL)
----
-0.1	0.1

# unary +
query II
SELECT +('0.1'::DECIMAL), +('-0.1'::DECIMAL)
----
0.1	-0.1

# addition
query I
SELECT '0.1'::DECIMAL + '0.1'::DECIMAL
----
0.2

# addition with non-decimal
query I
SELECT '0.1'::DECIMAL + 1::INTEGER
----
1.1

# addition that would overflow the base types
query I
SELECT '0.5'::DECIMAL(4,4) + '0.5'::DECIMAL(4,4)
----
1.0

# addition between different decimal types
query I
SELECT '0.5'::DECIMAL(1,1) + '100.0'::DECIMAL(3,0)
----
100.5

# test decimals and integers with big decimals
query IIIIII
SELECT ('0.5'::DECIMAL(1,1) + 10000)::VARCHAR,
       ('0.54321'::DECIMAL(5,5) + 10000)::VARCHAR,
       ('0.5432154321'::DECIMAL(10,10) + 10000)::VARCHAR,
       ('0.543215432154321'::DECIMAL(15,15) + 10000::DECIMAL(20,15))::VARCHAR,
       ('0.54321543215432154321'::DECIMAL(20,20) + 10000)::VARCHAR,
       ('0.5432154321543215432154321'::DECIMAL(25,25) + 10000)::VARCHAR
----
10000.5
10000.54321
10000.5432154321
10000.543215432154321
10000.54321543215432154321
10000.5432154321543215432154321

# wide result
query I
SELECT ('0.54321543215432154321543215432154321'::DECIMAL(35,35) + 10000)::VARCHAR
----
10000.54321543215432154321543215432154321

# different types
query IIIII
SELECT '0.5'::DECIMAL(1,1) + 1::TINYINT,
       '0.5'::DECIMAL(1,1) + 1::SMALLINT,
       '0.5'::DECIMAL(1,1) + 1::INTEGER,
       '0.5'::DECIMAL(1,1) + 1::BIGINT,
       '0.5'::DECIMAL(1,1) + 1::HUGEINT
----
1.5	1.5	1.5	1.5	1.5

# negative numbers
query IIIII
SELECT '0.5'::DECIMAL(1,1) + -1::TINYINT,
       '0.5'::DECIMAL(1,1) + -1::SMALLINT,
       '0.5'::DECIMAL(1,1) + -1::INTEGER,
       '0.5'::DECIMAL(1,1) + -1::BIGINT,
       '0.5'::DECIMAL(1,1) + -1::HUGEINT
----
-0.5	-0.5	-0.5	-0.5	-0.5

# subtract
query IIIII
SELECT '0.5'::DECIMAL(1,1) - 1::TINYINT,
       '0.5'::DECIMAL(1,1) - 1::SMALLINT,
       '0.5'::DECIMAL(1,1) - 1::INTEGER,
       '0.5'::DECIMAL(1,1) - 1::BIGINT,
       '0.5'::DECIMAL(1,1) - 1::HUGEINT
----
-0.5	-0.5	-0.5	-0.5	-0.5

# negative numbers
query IIIII
SELECT '0.5'::DECIMAL(1,1) - -1::TINYINT,
       '0.5'::DECIMAL(1,1) - -1::SMALLINT,
       '0.5'::DECIMAL(1,1) - -1::INTEGER,
       '0.5'::DECIMAL(1,1) - -1::BIGINT,
       '0.5'::DECIMAL(1,1) - -1::HUGEINT
----
1.5	1.5	1.5	1.5	1.5

# now with a table
statement ok
CREATE TABLE decimals(d DECIMAL(3, 2));

statement ok
INSERT INTO decimals VALUES ('0.1'), ('0.2');

query I
SELECT d + 10000 FROM decimals;
----
10000.1
10000.2

query II
SELECT d + '0.1'::DECIMAL, d + 10000 FROM decimals;
----
0.2	10000.1
0.3	10000.2

# multiplication
query I
SELECT '0.1'::DECIMAL * '10.0'::DECIMAL
----
1.0

query I
SELECT typeof('0.1'::DECIMAL(2,1) * '10.0'::DECIMAL(3,1))
----
DECIMAL(5,2)

query I
SELECT '0.1'::DECIMAL * '0.1'::DECIMAL
----
0.01

# multiplication with non-decimal
query I
SELECT '0.1'::DECIMAL * 10::INTEGER
----
1.0

# multiplication that would overflow the base types
query I
SELECT '5.0'::DECIMAL(4,3) * '5.0'::DECIMAL(4,3)
----
25.0

# negative multiplication
query I
SELECT '-5.0'::DECIMAL(4,3) * '5.0'::DECIMAL(4,3)
----
-25.0

# no precision is lost
query I
SELECT ('18.25'::DECIMAL(4,2) * '17.25'::DECIMAL(4,2))::VARCHAR
----
314.8125

# different types
query IIIII
SELECT '0.001'::DECIMAL * 100::TINYINT,
       '0.001'::DECIMAL * 10000::SMALLINT,
       '0.001'::DECIMAL * 1000000::INTEGER,
       '0.001'::DECIMAL * 100000000::BIGINT,
       '0.001'::DECIMAL * 10000000000::HUGEINT
----
0.100
10.000
1000.000
100000.000
10000000.000

# the multiplication is performed exactly as a wide decimal
query I
SELECT '0.000000000000000000000000000001'::DECIMAL(38,30) * '0.000000000000000000000000000001'::DECIMAL(38,30)
----
0.000000000000000000000000000000000000000000000000000000000001

# the scale of a product grows with the width
query II
SELECT '0.1'::DECIMAL(200,150) * '0.1'::DECIMAL(200,150) = '0.01'::DECIMAL(400,300), typeof('0.1'::DECIMAL(200,150) * '0.1'::DECIMAL(200,150))
----
true	DECIMAL(400,300)

# test addition, subtraction and multiplication with various scales and precisions
query IIII
SELECT 2.0 + 1.0,
       2.0000 + 1.0000,
       2.000000000000 + 1.000000000000,
       2.00000000000000000000 + 1.00000000000000000000
----
3.0
3.0000
3.000000000000
3.00000000000000000000

query IIII
SELECT 2.0 - 1.0,
       2.0000 - 1.0000,
       2.000000000000 - 1.000000000000,
       2.00000000000000000000 - 1.00000000000000000000
----
1.0
1.0000
1.000000000000
1.00000000000000000000

query II
SELECT 2.0 * 1.0,
       2.0000 * 1.0000
----
2.0
2.0000

# an integer operand of a decimal +, - or % is cast to the result type once, not through the decimal that holds it
statement ok
CREATE TABLE decimal_operands AS SELECT 1.5::DECIMAL(5,2) AS d, 1::INTEGER AS i, 2::BIGINT AS b FROM range(3);

query II
EXPLAIN SELECT d + i FROM decimal_operands;
----
physical_plan	<REGEX>:[\s\S]*CAST\(i AS DECIMAL\(13,2\)\)[\s\S]*

query II
EXPLAIN SELECT d + i FROM decimal_operands;
----
physical_plan	<!REGEX>:[\s\S]*CAST\(CAST\([\s\S]*

query II
EXPLAIN SELECT b - d FROM decimal_operands;
----
physical_plan	<REGEX>:[\s\S]*CAST\(b AS DECIMAL\(22,2\)\)[\s\S]*

query II
EXPLAIN SELECT b - d FROM decimal_operands;
----
physical_plan	<!REGEX>:[\s\S]*CAST\(CAST\([\s\S]*

query II
EXPLAIN SELECT d % i FROM decimal_operands;
----
physical_plan	<REGEX>:[\s\S]*CAST\(i AS DECIMAL\(12,2\)\)[\s\S]*

query II
EXPLAIN SELECT d % i FROM decimal_operands;
----
physical_plan	<!REGEX>:[\s\S]*CAST\(CAST\([\s\S]*

# a cast that can fail is kept: a HUGEINT does not always fit DECIMAL(38,0), and neither does a narrower cast by hand
query II
EXPLAIN SELECT d + i::HUGEINT FROM decimal_operands;
----
physical_plan	<REGEX>:[\s\S]*CAST\(CAST\(i AS HUGEINT\) AS DECIMAL\(38,0\)\)[\s\S]*

query II
EXPLAIN SELECT d + i::DECIMAL(5,0) FROM decimal_operands;
----
physical_plan	<REGEX>:[\s\S]*CAST\(CAST\(i AS DECIMAL\(5,0\)\) AS DECIMAL\(8,2\)\)[\s\S]*

query IIIIII
SELECT d + i, typeof(d + i), b - d, typeof(b - d), d % i, typeof(d % i) FROM decimal_operands LIMIT 1;
----
2.50	DECIMAL(13,2)	0.50	DECIMAL(22,2)	0.50	DECIMAL(12,2)

# the same for an integer factor of a decimal product
statement ok
CREATE TABLE decimal_factors AS SELECT 1.5::DECIMAL(5,2) AS d, 3::TINYINT AS t, 4::SMALLINT AS s FROM range(3);

query II
EXPLAIN SELECT d * t FROM decimal_factors;
----
physical_plan	<REGEX>:[\s\S]*CAST\(t AS DECIMAL\(8,0\)\)[\s\S]*

query II
EXPLAIN SELECT d * t FROM decimal_factors;
----
physical_plan	<!REGEX>:[\s\S]*CAST\(CAST\([\s\S]*

query II
EXPLAIN SELECT s * d FROM decimal_factors;
----
physical_plan	<REGEX>:[\s\S]*CAST\(s AS DECIMAL\(10,0\)\)[\s\S]*

query II
EXPLAIN SELECT s * d FROM decimal_factors;
----
physical_plan	<!REGEX>:[\s\S]*CAST\(CAST\([\s\S]*

query IIII
SELECT d * t, typeof(d * t), s * d, typeof(s * d) FROM decimal_factors LIMIT 1;
----
4.50	DECIMAL(8,2)	6.00	DECIMAL(10,2)
