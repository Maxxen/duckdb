# name: test/sql/types/geo/geometry_crs.test
# group: [geo]

query I
select st_crs(NULL);
----
NULL

query I
select st_crs('foobar');
----
NULL

statement error
select st_crs(1);
----
Binder Error: No function matches the given name and argument types

# a type that has a type where a geometry has its CRS
statement error
select st_crs([1, 2]);
----
Binder Error: No function matches the given name and argument types

# a type that has a value where a geometry has its CRS
statement ok
create type mood as enum ('sad', 'ok');

statement error
select st_crs('sad'::mood);
----
Binder Error: No function matches the given name and argument types 'st_crs(ENUM('sad', 'ok'))'

statement error
select st_crs(1::DECIMAL(10,2));
----
Binder Error: No function matches the given name and argument types 'st_crs(DECIMAL(10,2))'

statement ok
create table collated (s VARCHAR COLLATE nocase);

statement error
select st_crs(s) from collated;
----
Binder Error: No function matches the given name and argument types 'st_crs(VARCHAR('nocase'))'

query I
select st_crs(st_setcrs('POINT(0 1)', 'OGC:CRS84'));
----
OGC:CRS84

# a CRS that is not identified
query I
select st_crs(st_setcrs('POINT(0 1)', 'EPSG:4326'));
----
EPSG:4326

# is kept as it is given, also by the type
query II
select typeof(NULL::GEOMETRY('EPSG:4326')), typeof(NULL::GEOGRAPHY('FOO'));
----
GEOMETRY('EPSG:4326')	GEOGRAPHY('FOO')

query II
select st_crs('POINT(0 1)'::GEOMETRY('FOO')), st_crs(st_setcrs('POINT(0 1)'::GEOGRAPHY, 'FOO'));
----
FOO	FOO

# unless the session ignores it
statement ok
set ignore_unknown_crs=true;

query I
select typeof(NULL::GEOMETRY('FOO'));
----
GEOMETRY

statement ok
reset ignore_unknown_crs;

statement ok
create table t1 (g GEOMETRY('OGC:CRS84'));

statement ok
create table t2 (g GEOMETRY('OGC:CRS83'));

statement ok
insert into t2 values ('POINT(0 1)');

# We cannot insert into t1 from t2 because of CRS mismatch
statement error
insert into t1 select * from t2;
----
Binder Error: Cannot cast GEOMETRY with CRS 'OGC:CRS83' to GEOMETRY with different CRS 'OGC:CRS84'

# But we can insert unknown CRS
statement ok
insert into t2 select st_setcrs(g, '') from t1;

query I
select * from t2;
----
POINT (0 1)

query I
select st_crs(g) from t2;
----
OGC:CRS83

# CRS Must be a string
statement error
select 'POINT(0 1)'::GEOMETRY((['abc']));
----
Parser Error: Expected a constant as type modifier

statement error
select 'POINT(0 1)'::GEOMETRY(4326);
----
<REGEX>:Binder Error.*does not accept type parameters \(INTEGER\).*

# ST_SetCRS must be constant
statement ok
create table t3 (srid VARCHAR, g GEOMETRY);

statement ok
insert into t3 values ('EPSG:4326', 'POINT(0 1)');

statement error
select st_setcrs(g, srid) from t3;
----
<REGEX>:.*Binder Error.*st_setcrs.*must be a constant expression.*

