# name: test/sql/types/variant/variant_decimal_arithmetic.test
# description: DECIMAL arithmetic with VARIANT operands is computed as DOUBLE
# group: [variant]

# a VARIANT is not passed as a decimal, so the operator is the one over DOUBLE
query IIIII
SELECT 10.0 % (2.0)::VARIANT, 10.0 + (2.0)::VARIANT, 1.5::VARIANT - 1.5, 10.5 * 1::VARIANT, TRY(1.5 + 1::VARIANT);
----
0.0	12.0	0.0	10.5	2.5

query I
SELECT typeof(10.0 + (2.0)::VARIANT);
----
DOUBLE

query I
SELECT 10.5 + (1::VARIANT)::DECIMAL(5,1);
----
11.5
