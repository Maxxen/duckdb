# name: test/sql/types/enum/standalone_enum.test
# description: Test stand-alone enums
# group: [enum]

query I
SELECT 'hello'::ENUM('world', 'hello');
----
hello

statement ok
CREATE TABLE test AS SELECT 'hello'::ENUM('world', 'hello') AS h;

query I
SELECT * FROM test
----
hello

# an ENUM with no members is a legal type - it just has no value that can be cast to it
query I
SELECT typeof(NULL::ENUM);
----
ENUM()

statement error
SELECT 'hello'::ENUM;
----
Could not convert string 'hello'

statement error
SELECT ENUM 'a';
----
Could not convert string 'a'

statement error
SELECT 'hello'::ENUM(42);
----
ENUM type requires a set of VARCHAR arguments

statement error
SELECT 'hello'::ENUM('zzz', 42);
----
ENUM type requires a set of VARCHAR arguments

statement error
SELECT 'hello'::ENUM(foobar 42);
----
Parser Error: syntax error at or near "42"
