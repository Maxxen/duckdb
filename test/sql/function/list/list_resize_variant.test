----
No function matches the given name and argument types

statement error
SELECT array_resize([1,2,3]::VARIANT, 5);
----
No function matches the given name and argument types

query I
SELECT list_resize([1,2,3], 5);
----
[1, 2, 3, NULL, NULL]
