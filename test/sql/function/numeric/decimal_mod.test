# name: test/sql/function/numeric/decimal_mod.test
# description: Test decimal modulo
# group: [numeric]

query II
SELECT 10 % 2.4, -10 % 2.4
----
0.4	-0.4

query II
SELECT 10.0 % 2.4, -10.0 % 2.4
----
0.4	-0.4

# large decimals
query I
SELECT 12345678901111111 % 2.0;
----
1

query I
select 12345678901234567890 % 123;
----
78

# if the common decimal exceeds the maximum decimal width it keeps the integer digits
query II
SELECT 10000000000000000000000000000000000001::DECIMAL(38,0) % 3::DECIMAL(38,10),
       typeof(10000000000000000000000000000000000001::DECIMAL(38,0) % 3::DECIMAL(38,10))
----
2	DECIMAL(38,0)

# a divisor that only has digits beyond the common scale is rounded to zero
statement error
SELECT 10000000000000000000000000000000000001::DECIMAL(38,0) % 0.00000000000000000000000000000000004
----
<REGEX>:.*Division by zero.*

query II
SELECT typeof(10.0 % 2.0), typeof(10.0 % 2.0 % 2.0 % 2.0)
----
DECIMAL(3,1)	DECIMAL(3,1)

statement error
SELECT 10.0 % 0.0
----
<REGEX>:.*Division by zero.*

query I
SELECT TRY(10.0 % 0.0)
----
NULL
