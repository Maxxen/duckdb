# name: test/sql/prepared/prepare_parameter_resolution.test
# description: Which calls with an untyped parameter are bound at PREPARE, and which wait for its type
# group: [prepared]

# the other argument, or the function itself, determines the types: the statement is bound at PREPARE
statement ok
PREPARE cmp_eq AS SELECT ? = 1;

statement ok
PREPARE cmp_eq_flipped AS SELECT 1 = ?;

statement ok
PREPARE cmp_lt AS SELECT ? < 1;

statement ok
PREPARE cmp_string AS SELECT ? = 'a';

statement ok
PREPARE cmp_distinct AS SELECT ? IS NOT DISTINCT FROM 1;

statement ok
PREPARE cmp_column AS SELECT i = ? FROM range(3) t(i) ORDER BY i;

statement ok
PREPARE list_value_typed AS SELECT list_value(1, ?);

statement ok
PREPARE list_contains_typed AS SELECT list_contains([1, 2], ?);

statement ok
PREPARE array_value_typed AS SELECT array_value(?, 2);

statement ok
PREPARE coalesce_typed AS SELECT coalesce(?, 1);

# the return type, or the type another argument is passed as, is left to the parameter: bound at EXECUTE
statement ok
PREPARE list_value_only AS SELECT list_value(?);

statement ok
PREPARE list_value_null AS SELECT list_value(?, NULL);

statement ok
PREPARE list_value_null_first AS SELECT list_value(NULL, ?);

statement ok
PREPARE list_contains_string AS SELECT list_contains('[1,2]', ?);

statement ok
PREPARE array_distance_both AS SELECT array_distance(?, ?);

statement ok
PREPARE array_distance_one AS SELECT array_distance([1.0, 2.0]::FLOAT[2], ?);

statement ok
PREPARE typeof_only AS SELECT typeof(?);

query II
SELECT name, result_types FROM duckdb_prepared_statements() ORDER BY result_types IS NULL, name;
----
array_value_typed	['INTEGER[2]']
cmp_column	[BOOLEAN]
cmp_distinct	[BOOLEAN]
cmp_eq	[BOOLEAN]
cmp_eq_flipped	[BOOLEAN]
cmp_lt	[BOOLEAN]
cmp_string	[BOOLEAN]
coalesce_typed	[INTEGER]
list_contains_typed	[BOOLEAN]
list_value_typed	['INTEGER[]']
array_distance_both	NULL
array_distance_one	NULL
list_contains_string	NULL
list_value_null	NULL
list_value_null_first	NULL
list_value_only	NULL
typeof_only	NULL

query I
EXECUTE cmp_eq(1);
----
true

query I
EXECUTE cmp_eq_flipped(1);
----
true

query I
EXECUTE cmp_lt(0);
----
true

query I
EXECUTE cmp_string('a');
----
true

query I
EXECUTE cmp_distinct(1);
----
true

query I
EXECUTE cmp_column(1);
----
false
true
false

query I
EXECUTE list_value_typed(42);
----
[1, 42]

query I
EXECUTE list_contains_typed(2);
----
true

query I
EXECUTE array_value_typed(1);
----
[1, 2]

query I
EXECUTE coalesce_typed(NULL);
----
1

query I
EXECUTE list_value_only(42);
----
[42]

query I
EXECUTE list_value_null(42);
----
[42, NULL]

query I
EXECUTE list_value_null_first(42);
----
[NULL, 42]

query I
EXECUTE list_contains_string(2);
----
true

query I
EXECUTE array_distance_both([1.0, 2.0]::FLOAT[2], [2.0, 3.0]::FLOAT[2]);
----
1.4142135

query I
EXECUTE array_distance_one([2.0, 3.0]::FLOAT[2]);
----
1.4142135

query I
EXECUTE typeof_only(42);
----
INTEGER

# a value of another type binds the statement again
query I
EXECUTE list_value_typed('7');
----
[1, 7]

query I
EXECUTE list_value_only('a');
----
[a]

query I
EXECUTE typeof_only('a');
----
VARCHAR

# in a comparison one side determines the type of the other: bound at PREPARE
statement ok
PREPARE between_typed AS SELECT ? BETWEEN 1 AND 2;

statement ok
PREPARE between_bounds AS SELECT i BETWEEN ? AND ? FROM range(3) t(i) ORDER BY i;

statement ok
PREPARE in_typed AS SELECT ? IN (1, 2);

# a parameter that nothing but itself determines waits for its type, however the function is called
statement ok
PREPARE cmp_both AS SELECT ? = ?;

statement ok
PREPARE between_all AS SELECT ? BETWEEN ? AND ?;

statement ok
PREPARE cmp_function AS SELECT "="(?, 1);

statement ok
PREPARE list_zip_only AS SELECT list_zip(?);

query II
SELECT name, result_types
FROM duckdb_prepared_statements()
WHERE name IN ('between_typed', 'between_bounds', 'in_typed', 'cmp_both', 'between_all', 'cmp_function', 'list_zip_only')
ORDER BY result_types IS NULL, name;
----
between_bounds	[BOOLEAN]
between_typed	[BOOLEAN]
in_typed	[BOOLEAN]
between_all	NULL
cmp_both	NULL
cmp_function	NULL
list_zip_only	NULL

query I
EXECUTE between_typed(1);
----
true

query I
EXECUTE between_bounds(0, 1);
----
true
true
false

query I
EXECUTE in_typed(2);
----
true

query I
EXECUTE cmp_both(1, 1);
----
true

query I
EXECUTE cmp_both('a', 'b');
----
false

query I
EXECUTE between_all(2, 1, 3);
----
true

query I
EXECUTE cmp_function(1);
----
true

query I
EXECUTE list_zip_only([1, 2]);
----
[(1,), (2,)]
